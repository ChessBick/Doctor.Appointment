@page "/doctor/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<PageTitle>Doctor Dashboard</PageTitle>

<AuthorizeView Roles="Doctor">
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            <MudText Typo="Typo.h3" GutterBottom="true">Doctor Dashboard</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Manage your appointments and patients</MudText>

            <MudGrid Class="mt-4">
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Today's Appointments</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">View today's schedule</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">View Schedule</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Patient List</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage your patients</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">View Patients</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h5">Availability</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Set your availability</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">Manage</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
            <MudPaper Class="pa-8" Elevation="3">
                <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">Access Denied</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                    You need to be logged in as a Doctor to access this page.
                </MudText>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Login
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>